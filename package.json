{
  "name": "contact-form",
  "version": "1.0.0",
  "description": "GCP Cloud Run Function to handle contact form submissions",
  "main": "dist/app.js",
  "private": true,
  "scripts": {
    "build": "npm run clean && npm run typecheck && npm run bundle",
    "gcp-build": "npm run build",
    "start": "functions-framework --target=contact",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/app.ts --bundle --platform=node --target=node24 --format=esm --packages=external --sourcemap --outfile=dist/app.js"
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "dotenv": "^18.0.9",
    "mailtrap": "^6.0.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "cloudevents": {
      "uuid": "^11.1.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
